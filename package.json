    "android:icons": "capacitor-assets generate --android --androidProject android",
    "android:run": "node scripts/android.mjs run",
    "android:live": "node scripts/android.mjs live",
    "android:release": "node scripts/android.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
