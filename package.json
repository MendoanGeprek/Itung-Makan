{
  "name": "itung-makan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kalkulator patungan makanan yang adil — memisahkan diskon proporsional dari biaya tambahan.",
  "scripts": {
    "dev": "vite",
